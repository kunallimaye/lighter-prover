# ─── Stage 1: Fast Native Cross-Compilation on x86_64 ────────────────
FROM --platform=linux/amd64 rust:1.82-bookworm AS builder

WORKDIR /app

# Install required upstream nightly toolchain
COPY rust-toolchain ./
RUN rustup install $(cat rust-toolchain) && rustup default $(cat rust-toolchain)

# Install Linux ARM64 GNU C cross-linker
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
    && rm -rf /var/lib/apt/lists/*

# Register ARM64 Rust compilation target
RUN rustup target add aarch64-unknown-linux-gnu

# Copy manifests for dependency resolution
COPY Cargo.toml Cargo.lock ./
COPY circuit/Cargo.toml circuit/Cargo.toml
COPY bench/Cargo.toml bench/Cargo.toml

# Copy circuit and bench crates
COPY circuit/ circuit/
COPY bench/ bench/

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc

# Compile release STARK proving crate at full native hardware CPU speed
RUN cargo build --release --target aarch64-unknown-linux-gnu --bin bench

# ─── Stage 2: Native ARM64 Runtime Packaging ──────────────────────────
FROM --platform=linux/arm64 debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /data

# Copy cross-compiled ARM64 binary and default benchmark fixture
COPY --from=builder /app/target/aarch64-unknown-linux-gnu/release/bench /usr/local/bin/bench
COPY bench/bench_test.json /data/bench_test.json

ENV RUST_LOG=info

ENTRYPOINT ["bench"]
