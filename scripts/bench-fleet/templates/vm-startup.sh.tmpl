#!/bin/bash
# GCE startup script for bench-fleet (#33: Container-Optimized OS edition).
# Runs as root on COS (cos-stable / cos-arm64-stable). Rendered by
# provision.sh with the __PLACEHOLDER__ tokens substituted before being
# passed via --metadata-from-file=startup-script.
#
# Container pivot (#33): the VM no longer installs a toolchain or builds
# anything. It pulls the prebuilt per-microarch bench image from Artifact
# Registry and runs one worker container per S value. The container's own
# entrypoint (cicd/entrypoint.sh, #25 contract) uploads bench.log +
# bench.jsonl + a per-S DONE sentinel to
#   gs://<bucket>/<run-id>/<machine>/S<S>/
# This script only handles: docker auth, pull, per-S orchestration,
# machine-info capture, and the FLEET-level _DONE sentinel at
#   gs://<bucket>/<run-id>/<machine>/_DONE
# (which lib/monitor.sh polls to delete the VM).
#
# COS notes:
#  - docker + docker-credential-gcr are preinstalled; there is NO gcloud
#    on the host. All GCS uploads from this script run gcloud INSIDE a
#    container (the bench image ships google-cloud-cli; if the pull
#    failed we fall back to google/cloud-sdk:slim so diagnostics still
#    land in GCS).
#  - /var is writable; we stage fleet artifacts in /var/lib/fleet.
#
# IMPORTANT: This script intentionally does NOT use `set -e`. We want
# every phase to attempt to upload its partial results (even after a
# failure) so the operator can diagnose from GCS. Per issue #23: never
# report status=ok when something failed — no `|| true` lying.

set -uo pipefail
exec > >(tee /var/log/startup.log) 2>&1
echo "FLEET_START $(date -Is)"

IMAGE="__IMAGE__"              # full AR URI incl. per-microarch tag
BUCKET="__BUCKET__"            # e.g. gs://kunal-scratch-bench-fleet-runs
RUN_PREFIX="__RUN_PREFIX__"    # e.g. <run-id>/<machine_type>/  (trailing slash)
SVALUES="__SVALUES__"          # e.g. "1 2 4 6"
HOST_LABEL="__HOST_LABEL__"    # e.g. c4a-highcpu-32
TX_LIMIT="__TX_LIMIT__"        # e.g. 480 (LIGHTER_TX_LIMIT in the container)

# entrypoint.sh expects BENCH_BUCKET WITHOUT the gs:// scheme (it
# constructs dest="gs://${BENCH_BUCKET}/${BENCH_PREFIX}/").
BUCKET_NAME="${BUCKET#gs://}"
REGISTRY_HOST="${IMAGE%%/*}"   # e.g. us-central1-docker.pkg.dev
FLEET_DIR=/var/lib/fleet
mkdir -p "${FLEET_DIR}"

# Which image to use for fleet-level gcloud uploads. Starts as the cloud-sdk
# fallback; switched to $IMAGE once the pull succeeds (saves a Docker Hub
# pull in the happy path).
GCLOUD_IMAGE="google/cloud-sdk:slim"

# ---------- Upload + sentinel helpers (defined first so failure paths can call them) ----------
# fleet_cp <src-in-/var/lib/fleet-or-/var/log> <gcs-dst> -- gcloud storage cp
# via container, one retry after 5s. Returns the final cp exit code.
fleet_cp() {
  local rc=0
  timeout 10m docker run --rm \
    -v "${FLEET_DIR}":/fleet:ro \
    -v /var/log:/hostlog:ro \
    --entrypoint gcloud \
    "${GCLOUD_IMAGE}" storage cp "$@" 2>&1 | tail -5
  rc=${PIPESTATUS[0]}
  if [[ ${rc} -ne 0 ]]; then
    echo "FLEET_UPLOAD_RETRY $(date -Is) rc=${rc} -- retrying in 5s: gcloud storage cp $*"
    sleep 5
    timeout 10m docker run --rm \
      -v "${FLEET_DIR}":/fleet:ro \
      -v /var/log:/hostlog:ro \
      --entrypoint gcloud \
      "${GCLOUD_IMAGE}" storage cp "$@" 2>&1 | tail -5
    rc=${PIPESTATUS[0]}
  fi
  return "${rc}"
}

upload_and_signal_done() {
  local STATUS="${1:-ok}"
  local UPLOAD_RC=0 rc=0
  echo "${STATUS}" > "${FLEET_DIR}/status.txt"

  local f
  for f in machine-info.txt svalues-summary.txt status.txt; do
    [[ -f "${FLEET_DIR}/${f}" ]] || continue
    fleet_cp "/fleet/${f}" "${BUCKET}/${RUN_PREFIX}${f}"
    rc=$?
    if [[ ${rc} -ne 0 && ${UPLOAD_RC} -eq 0 ]]; then UPLOAD_RC=${rc}; fi
  done

  fleet_cp /hostlog/startup.log "${BUCKET}/${RUN_PREFIX}startup.log"
  rc=$?
  if [[ ${rc} -ne 0 && ${UPLOAD_RC} -eq 0 ]]; then UPLOAD_RC=${rc}; fi

  if [[ ${UPLOAD_RC} -ne 0 ]]; then
    # Never report status=ok when uploads failed (issue #23 lesson).
    echo "FLEET_UPLOAD_FAILED rc=${UPLOAD_RC}"
    STATUS="${STATUS}+upload-failed-rc${UPLOAD_RC}"
  fi

  # FLEET SENTINEL — orchestrator polls for this file and deletes the VM.
  echo "${STATUS} @ $(date -Is)" > "${FLEET_DIR}/_done_sentinel.txt"
  fleet_cp /fleet/_done_sentinel.txt "${BUCKET}/${RUN_PREFIX}_DONE"
  rc=$?
  if [[ ${rc} -ne 0 ]]; then
    echo "FLEET_UPLOAD_FAILED rc=${rc} (sentinel _DONE could not be written)"
  fi
  echo "FLEET_UPLOAD_DONE $(date -Is) status=${STATUS}"
}

# ---------- 1. Docker auth for Artifact Registry ----------
# COS ships docker-credential-gcr; it auths docker pulls via the VM's
# metadata-server identity (the default Compute SA, which needs
# roles/artifactregistry.reader — granted by `make admin-cloud-init`).
echo "FLEET_DOCKER_AUTH_START $(date -Is)"
# COS mounts /root read-only — docker config must live on the writable
# stateful partition. Both `docker` and `docker-credential-gcr` honor
# DOCKER_CONFIG, so point it at the fleet dir under /var/lib.
export DOCKER_CONFIG="${FLEET_DIR}/.docker"
mkdir -p "${DOCKER_CONFIG}"
docker-credential-gcr configure-docker --registries="${REGISTRY_HOST}"
AUTH_RC=$?
echo "FLEET_DOCKER_AUTH_DONE $(date -Is) rc=${AUTH_RC}"

# ---------- 2. Pull the prebuilt bench image (retry 3x) ----------
echo "FLEET_PULL_START $(date -Is) image=${IMAGE}"
PULL_RC=1
for attempt in 1 2 3; do
  if docker pull "${IMAGE}" 2>&1 | tail -5; then
    PULL_RC=0
    break
  fi
  echo "FLEET_PULL_RETRY $(date -Is) attempt=${attempt} failed -- sleeping 15s"
  sleep 15
done
echo "FLEET_PULL_DONE $(date -Is) rc=${PULL_RC}"

if [[ ${PULL_RC} -ne 0 ]]; then
  echo "FLEET_PULL_FAILED -- uploading diagnostics via cloud-sdk fallback and bailing"
  upload_and_signal_done "pull-failed"
  exit 1
fi
# Pull succeeded — the bench image ships gcloud; use it for fleet uploads
# (no Docker Hub dependency in the happy path).
GCLOUD_IMAGE="${IMAGE}"

IMAGE_DIGEST="$(docker inspect --format='{{index .RepoDigests 0}}' "${IMAGE}" 2>/dev/null || echo unknown)"

# ---------- 3. Machine info ----------
# No toolchain on COS (nothing is built here) — provenance is the image
# URI + digest instead of rustc version (#33).
{
  echo "=== host_label ==="
  echo "${HOST_LABEL}"
  echo
  echo "=== image ==="
  echo "uri:    ${IMAGE}"
  echo "digest: ${IMAGE_DIGEST}"
  echo
  echo "=== lscpu ==="
  lscpu
  echo
  echo "=== free -h ==="
  free -h
  echo
  echo "=== uname -a ==="
  uname -a
} > "${FLEET_DIR}/machine-info.txt"
echo "FLEET_MACHINE_INFO_DONE $(date -Is) digest=${IMAGE_DIGEST}"

# ---------- 4. Per-S worker containers ----------
# Each container runs the #25 contract: bench once with
# LIGHTER_TX_PER_PROOF=S, then the entrypoint itself uploads bench.log +
# bench.jsonl + DONE to gs://$BENCH_BUCKET/$BENCH_PREFIX/. GCS auth flows
# from the VM's metadata server (default Compute SA) — containers on the
# default bridge reach 169.254.169.254.
: > "${FLEET_DIR}/svalues-summary.txt"
FAIL_COUNT=0
for S in ${SVALUES}; do
  echo "FLEET_S${S}_START $(date -Is)"
  S_START=$(date +%s)
  timeout 4h docker run --rm --name "bench-S${S}" \
    -e LIGHTER_TX_PER_PROOF="${S}" \
    -e LIGHTER_TX_LIMIT="${TX_LIMIT}" \
    -e BENCH_BUCKET="${BUCKET_NAME}" \
    -e BENCH_PREFIX="${RUN_PREFIX}S${S}" \
    -e RUST_LOG=info \
    "${IMAGE}" 2>&1 | tail -20
  S_RC=${PIPESTATUS[0]}
  # If timeout killed the client, make sure the container is gone too.
  docker rm -f "bench-S${S}" >/dev/null 2>&1
  S_WALL=$(( $(date +%s) - S_START ))
  echo "FLEET_S${S}_DONE $(date -Is) rc=${S_RC} wall=${S_WALL}s"
  echo "S${S} rc=${S_RC} wall_seconds=${S_WALL}" >> "${FLEET_DIR}/svalues-summary.txt"
  if [[ ${S_RC} -ne 0 ]]; then
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
done

# ---------- 5. Fleet-level upload + sentinel ----------
# Honest status (issue #23): only "ok" when every S exited 0 AND the
# fleet-level uploads succeed.
if [[ ${FAIL_COUNT} -eq 0 ]]; then
  upload_and_signal_done "ok"
else
  upload_and_signal_done "bench-failed-${FAIL_COUNT}"
fi

# ---------- 6. No in-VM self-delete ----------
# The default Compute SA lacks compute.instances.delete by design. The
# orchestrator (lib/monitor.sh) deletes the VM once it sees the _DONE
# sentinel. --max-run-duration=10h --instance-termination-action=DELETE
# on the instance is the belt-and-suspenders safety net.
echo "FLEET_END $(date -Is) -- awaiting orchestrator delete or max-run-duration"
