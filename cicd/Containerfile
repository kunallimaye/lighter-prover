# syntax=docker/dockerfile:1.6
#
# Lighter prover bench container — cross-compiled per-microarch matrix (#33)
# ──────────────────────────────────────────────────────────────────────────
#
# Multi-stage build:
#   1. builder — ALWAYS runs natively on the build host ($BUILDPLATFORM,
#      amd64 on Cloud Build). arm64 output is CROSS-COMPILED (rustc
#      emitting aarch64 via gcc-aarch64-linux-gnu linker), never run
#      under QEMU. Rationale: Cloud Build has no ARM workers (verified
#      June 2026 — default pool is e2/n1 x86 only; private pools are
#      e2/n2d/c3 x86 only), and a QEMU-emulated Rust compile is 10-20×
#      slower than cross-compilation. See ADR-0001 addendum (#33).
#   2. runtime — debian:stable-slim for the TARGET platform with the
#      bench binary, bench_test.json fixture, entrypoint (worker role
#      only — fan-out runs from the host, #21), google-cloud-cli (GCS
#      uploads, #25), and tini as
#      PID 1. The arm64 runtime stage is the ONLY thing that runs under
#      QEMU during a multi-platform build — it is apt installs only
#      (minutes, not hours) and its layers are shared by every arm64
#      variant in the same buildx builder.
#
# Build args:
#   LIGHTER_REF       Git SHA of the source tree COPY'd into the builder
#                     stage. Surfaces as GIT_SHA env (read by bench's
#                     machine-metadata header) and as the OCI
#                     org.opencontainers.image.revision label. Default is
#                     the literal "unknown" so an unset arg fails loudly.
#   TARGET_CPU        rustc -C target-cpu value. Default "portable"
#                     (no -C target-cpu flag — image runs anywhere of its
#                     arch). The fleet matrix (cicd/cloudbuild.yaml) sets:
#                       znver5       amd64 — GCP c4d / n4d (AMD Turin)
#                       neoverse-v2  arm64 — GCP c4a / n4a (Google Axion)
#                       neoverse-n1  arm64 — GCP t2a (Ampere Altra)
#                     "native" is also accepted for local builds.
#   TARGET_CPU_NATIVE DEPRECATED back-compat toggle (pre-#33). "1" maps
#                     to TARGET_CPU=native when TARGET_CPU is portable.
#   RUST_TOOLCHAIN    Rust toolchain version (default matches the
#                     rust-toolchain file at the repo root).
#   CARGO_FEATURES    Comma/space-separated cargo feature list passed to
#                     `cargo build` as `--features "${CARGO_FEATURES}"`.
#                     Default "" (empty) — no `--features` flag is emitted,
#                     so the portable multi-arch path stays byte-identical
#                     when unset. cicd/cloudbuild.yaml passes
#                     `native-pubsub` (issue #230) so the cross-machine
#                     fold-worker / `--native-merge-plane` paths are
#                     compiled in (bench/Cargo.toml [features]
#                     native-pubsub = ["dep:ureq"], rustls/ring TLS — no
#                     openssl-sys, stays cross-compile-safe on the
#                     x86->aarch64 build host).
#
# The builder asserts the produced binary's ELF architecture with
# file(1) and FAILS THE BUILD on mismatch — an amd64 binary can never
# ship in an arm64 image again (the pre-#30 "exec format error" class).

ARG LIGHTER_REF=unknown
ARG TARGET_CPU=portable
ARG TARGET_CPU_NATIVE=0
ARG RUST_TOOLCHAIN=nightly-2025-12-06
ARG CARGO_FEATURES=""

# ─── Stage 1: builder (native on $BUILDPLATFORM, cross-compiles) ─────
FROM --platform=$BUILDPLATFORM rustlang/rust:nightly-bookworm AS builder

ARG LIGHTER_REF
ARG TARGET_CPU
ARG TARGET_CPU_NATIVE
ARG RUST_TOOLCHAIN
ARG CARGO_FEATURES
# Provided by buildx from --platform: "amd64" or "arm64" (the platform
# of the image being PRODUCED, not the host this stage runs on).
ARG TARGETARCH

# Pinned toolchain + both std targets. Adding the host's own target is
# a no-op; the aarch64 target enables cross-compilation from the amd64
# build host. file(1) backs the arch assertion; gcc-aarch64-linux-gnu
# supplies the cross linker + cross strip (binutils dep).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      file gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
 && rm -rf /var/lib/apt/lists/* \
 && rustup toolchain install "${RUST_TOOLCHAIN}" --profile minimal \
 && rustup default "${RUST_TOOLCHAIN}" \
 && rustup target add --toolchain "${RUST_TOOLCHAIN}" \
      x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu

# Cross-link config for the aarch64 target. Harmless for amd64 builds.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc

WORKDIR /src

# Copy the source tree. The repo-root .dockerignore keeps target/, .git,
# and logs out of the build context.
COPY . .

ENV GIT_SHA=${LIGHTER_REF}

LABEL org.opencontainers.image.revision="${LIGHTER_REF}"
LABEL org.opencontainers.image.source="https://github.com/kunallimaye/lighter-prover"

# Build + arch-assert. The case statement maps the produced platform to
# the rust target triple, the expected file(1) substring, and the right
# strip binary. Cross-compiling for aarch64 here runs rustc NATIVELY on
# the build host — only the emitted code is arm64.
RUN set -eux; \
    case "${TARGETARCH:-$(uname -m)}" in \
      amd64|x86_64)  RUST_TARGET=x86_64-unknown-linux-gnu;  FILE_PAT='x86-64';      STRIP=strip ;; \
      arm64|aarch64) RUST_TARGET=aarch64-unknown-linux-gnu; FILE_PAT='ARM aarch64'; STRIP=aarch64-linux-gnu-strip ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH:-unset}" >&2; exit 1 ;; \
    esac; \
    CPU="${TARGET_CPU}"; \
    if [ "${CPU}" = "portable" ] && [ "${TARGET_CPU_NATIVE}" = "1" ]; then CPU=native; fi; \
    if [ "${CPU}" != "portable" ]; then export RUSTFLAGS="-C target-cpu=${CPU}"; fi; \
    FEATURES_FLAG=""; \
    if [ -n "${CARGO_FEATURES}" ]; then FEATURES_FLAG="--features ${CARGO_FEATURES}"; fi; \
    echo "Building bench: arch=${TARGETARCH} target=${RUST_TARGET} cpu=${CPU} RUSTFLAGS=${RUSTFLAGS:-<none>} CARGO_FEATURES=${CARGO_FEATURES:-<none>} LIGHTER_REF=${LIGHTER_REF}"; \
    cargo +"${RUST_TOOLCHAIN}" fetch; \
    cargo +"${RUST_TOOLCHAIN}" build --release -p bench --bin bench --target "${RUST_TARGET}" ${FEATURES_FLAG}; \
    mkdir -p /out; \
    cp "target/${RUST_TARGET}/release/bench" /out/bench; \
    "${STRIP}" /out/bench || true; \
    file /out/bench; \
    file /out/bench | grep -q "${FILE_PAT}" \
      || { echo "FATAL: /out/bench is not ${FILE_PAT} — arch mismatch" >&2; exit 1; }

# ─── Stage 2: runtime (target platform; arm64 under QEMU, apt only) ──
FROM debian:stable-slim AS runtime

# NOTE: keep the apt layer FIRST and free of ARG references so buildkit
# shares it across all per-microarch variants of the same platform —
# the QEMU-emulated arm64 apt install runs ONCE per build session.
#
# tini = PID 1 with proper signal handling.
# google-cloud-cli ships `gcloud storage`, which the worker entrypoint
# uses to upload results to GCS when BENCH_BUCKET is set (see #25).
# Google publishes arm64 debs for google-cloud-cli, so the same recipe
# works for both platforms.
#
# NOTE (#21): python3 / python3-pip were previously installed for the
# in-container "orchestrator" role (orchestrator.py). That role was
# removed — fan-out now runs only from the host — so they are no longer
# installed explicitly. (google-cloud-cli may still pull a python3
# runtime in transitively; that is its own dependency, not ours.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      tini \
      ca-certificates \
      curl \
      gnupg \
 && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
      | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
      > /etc/apt/sources.list.d/google-cloud-sdk.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends google-cloud-cli \
 && apt-get purge -y --auto-remove curl gnupg \
 && rm -rf /var/lib/apt/lists/*

# Non-root user. Cloud Run will pick its own UID; we still want a sane
# default for podman / local docker / COS.
RUN useradd --create-home --shell /bin/bash --uid 1000 bench

ARG LIGHTER_REF
ARG TARGET_CPU
ARG TARGET_CPU_NATIVE

LABEL org.opencontainers.image.revision="${LIGHTER_REF}"
LABEL org.opencontainers.image.source="https://github.com/kunallimaye/lighter-prover"
LABEL io.lighter.bench.target-cpu="${TARGET_CPU}"

WORKDIR /app

COPY --from=builder /out/bench /app/bench
COPY --from=builder /src/bench/bench_test.json /app/bench_test.json
# Witness corpus (#165): the {height, witness_index} index the cell role
# mounts at startup (ADR-0008 §1.1/§1.4). Baked into the image so cell pods
# resolve witness slices locally with no network on the prove path. A
# GCS-backed volume is the documented future upgrade (see
# docs/distributed-prover-runtime.md).
COPY --from=builder /src/bench/corpus /app/corpus
COPY cicd/entrypoint.sh /app/entrypoint.sh
# Binary-path reconciliation (#172): install the bench binary ALSO as
# /usr/local/bin/prover so the GKE tfvars can invoke
# `["/usr/local/bin/prover","--mode","cell"]` / `--mode coordinator` directly,
# while the worker entrypoint keeps using /app/bench. One binary, two names.
RUN chmod +x /app/entrypoint.sh \
 && ln -sf /app/bench /usr/local/bin/prover \
 && chown -R bench:bench /app

USER bench

# Defaults — every value is overridable at `docker run` / Cloud Run time.
# LIGHTER_TARGET_CPU_NATIVE is kept for back-compat with pre-#33
# consumers of the entrypoint banner; LIGHTER_TARGET_CPU is the real
# provenance signal now.
# Defaults keep the worker role (LIGHTER_ROLE=worker) byte-for-byte unchanged.
# For the distributed roles (#172) set LIGHTER_ROLE=coordinator|cell (or invoke
# /usr/local/bin/prover --mode ... directly) and provide the Pub/Sub config via
# LIGHTER_PROJECT / LIGHTER_DISPATCH_SUBSCRIPTION / LIGHTER_CHUNK_TOPIC /
# LIGHTER_CHUNK_SUBSCRIPTION / LIGHTER_RESULTS_TOPIC / LIGHTER_RESULTS_SUBSCRIPTION
# (the bench binary reads these via clap `env`). See
# docs/distributed-prover-runtime.md.
ENV LIGHTER_ROLE=worker \
    LIGHTER_BENCH_INPUT=/app/bench_test.json \
    LIGHTER_BENCH_REPEAT=1 \
    LIGHTER_WORKERS=1 \
    LIGHTER_TX_PER_PROOF=4 \
    LIGHTER_TX_LIMIT=480 \
    RUST_LOG=info \
    LIGHTER_REF=${LIGHTER_REF} \
    LIGHTER_TARGET_CPU=${TARGET_CPU} \
    LIGHTER_TARGET_CPU_NATIVE=${TARGET_CPU_NATIVE}

ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
