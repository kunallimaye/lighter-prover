# Project Configuration & Infrastructure VMs List
#
# Copy this file to config.toml and customize your settings.
# config.toml is gitignored — never commit it.
#
# This file defines the Google Cloud infrastructure and target Service Accounts
# that will be provisioned/used when running `make cloud-deploy`.

[project]
name = "lighter-prover"

[gcp.defaults]
project = "kunal-scratch"
region  = "us-central1"

# ─── Target Service Accounts ───────────────────────────────────────────
# Identities used during infrastructure deployment and runtime execution.
# These service accounts must exist prior to running `make cloud-deploy`.

[gcp.target]
build_sa   = "lighter-builder@kunal-scratch.iam.gserviceaccount.com"
runtime_sa = "lighter-runtime@kunal-scratch.iam.gserviceaccount.com"

# ─── Virtual Machines List ─────────────────────────────────────────────
# Add or remove VM entries below. Each block defines an individual GCE instance
# that will be provisioned by Terraform.

[vms]

[vms.prover-vm-1]
machine_type = "c4-standard-8"
zone         = "us-central1-a"
disk_size_gb = 100
disk_type    = "pd-ssd"

[vms.prover-vm-2]
machine_type = "c4-standard-16"
zone         = "us-central1-b"
disk_size_gb = 200
disk_type    = "pd-ssd"
