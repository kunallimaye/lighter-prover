# Project Configuration & Infrastructure Toolkit
#
# Copy this file to config.toml and customize your settings.
# config.toml is gitignored — never commit it.
#
# This file defines the Google Cloud infrastructure and target Service Accounts
# (including required IAM role allocations) for the Lighter prover platform.

[project]
name = "lighter-prover"

[gcp.defaults]
project = "kunal-scratch"
region  = "us-east4"

[gcp.state]
# Google Cloud Storage bucket used as remote backend for Terraform state files.
# Automatically verified and created by `make cloud-admin-init`.
bucket = "kunal-scratch-tfstate"
prefix = "lighter-prover-perf"

[gcp.registry]
# Google Cloud Artifact Registry repository name for managed container workloads.
# Automatically provisioned by Terraform during `make cloud-deploy`.
repository = "lighter-prover-iac"
# Repository location. Supports regions (e.g. us-central1) or multi-regions (us, europe, asia).
# Note: Google Cloud Artifact Registry does not support location "global".
region     = "us"

[gcp.bench]
# GCS destination bucket for remote benchmark telemetry uploads (defaults to state bucket if omitted).
bucket = "kunal-scratch-tfstate"
# GCS path template. Supports variables: {machine_type}, {instance_id}, {timestamp}, {build_id}.
path_template = "benchmark-reports/{machine_type}/{instance_id}/{timestamp}"

# ─── Target Service Accounts & Role Allocations ────────────────────────
# Identities and IAM permissions required by Cloud Build and runtime workloads.
# Note: You may add ANY arbitrary Service Account entries below (e.g. [gcp.target.monitor_sa]).
# Run `make cloud-admin-init` to automatically create all defined Service Accounts
# and bind the enumerated IAM roles on your Google Cloud project.
# Run `make cloud-admin-undo` to symmetrically revoke these roles and delete the SAs.

[gcp.target]
# Cloud Build execution machine type (e.g. UNSPECIFIED, E2_HIGHCPU_8, E2_HIGHCPU_32)
build_machine_type = "E2_HIGHCPU_32"

[gcp.target.build_sa]
email = "lighter-builder@kunal-scratch.iam.gserviceaccount.com"
# Roles expected by Cloud Build to execute Terraform pipelines and push images.
roles = [
  "roles/cloudbuild.builds.builder",
  "roles/storage.objectAdmin",
  "roles/artifactregistry.admin",
  "roles/compute.admin",
  "roles/iam.serviceAccountUser"
]

[gcp.target.runtime_sa]
email = "lighter-runtime@kunal-scratch.iam.gserviceaccount.com"
# Least-privilege roles expected by GCE instances / Cloud Run workloads at runtime.
roles = [
  "roles/artifactregistry.reader",
  "roles/logging.logWriter",
  "roles/monitoring.metricWriter",
  "roles/storage.objectAdmin"
]

# ─── Virtual Machines List & Default Inheritance ───────────────────────
# Define GCE instances provisioned when running `make cloud-deploy`.
# All individual VMs inherit properties from `[vms.default]` unless explicitly overridden.

[vms.default]
machine_type    = "c4a-highcpu-16"
zone            = "us-east4-b"
disk_size_gb    = 100
disk_type       = "hyperdisk-balanced"
# Default OS boot image (e.g. debian-cloud/debian-12, ubuntu-os-cloud/ubuntu-2204-lts)
image           = "debian-cloud/debian-12-arm64"
# Optional CPU Turbo Mode (e.g. ALL_CORE_MAX or empty). Keeps cores boosted during ZKP generation.
turbo_mode      = ""
service_account = "lighter-runtime@kunal-scratch.iam.gserviceaccount.com"

[vms.prover-vm-1]
# Inherits machine_type, zone, disk_size_gb, disk_type, and service_account exactly from [vms.default]

[vms.prover-vm-2]
machine_type = "c4a-highcpu-32"
zone         = "us-east4-b"
disk_size_gb = 200

[vms.prover-vm-3]
machine_type = "c4a-highcpu-8"

[vms.prover-vm-4]
machine_type = "c4a-highcpu-64"
disk_size_gb = 200

[vms.prover-vm-5]
machine_type = "c4a-highcpu-72"
disk_size_gb = 200

[vms.prover-vm-6]
machine_type = "c4a-highcpu-48"
disk_size_gb = 200

# ─── Indivisible Proving Pod Taxonomy & Execution Profiles ─────────────
# Defines collaborative Proving Pod specs (Leaf Workers + Tree Aggregators).
# Symmetrically reused across GKE Standard node pools and bare GCE MIGs.

[proving_pod.defaults]
arch   = "c3d" # AMD Genoa Zen 4 AVX-512 Sharding Frontier
engine = "gke"

[proving_pod.c4a]
machine_family = "c4a"
image          = "debian-cloud/debian-12-arm64"

[proving_pod.c4a.leaf_worker]
machine_type    = "c4a-highcpu-64"
disk_type       = "hyperdisk-balanced"
disk_size_gb    = 100
chunk_size      = 4
cpu_requests    = "64"
memory_requests = "128Gi"

[proving_pod.c4a.aggregator]
machine_type    = "c4a-highcpu-16"
disk_type      = "hyperdisk-balanced"
disk_size_gb    = 50
cpu_requests    = "16"
memory_requests = "32Gi"

[proving_pod.c3d]
machine_family = "c3d"
image          = "debian-cloud/debian-12"

[proving_pod.c3d.leaf_worker]
machine_type    = "c3d-highcpu-180"
disk_type       = "hyperdisk-balanced"
disk_size_gb    = 100
chunk_size      = 1 # AVX-512 Dynamic Sharding Optimum
cpu_requests    = "30"
memory_requests = "60Gi"

[proving_pod.c3d.aggregator]
machine_type    = "c3d-highcpu-30"
disk_type       = "hyperdisk-balanced"
disk_size_gb    = 50
cpu_requests    = "30"
memory_requests = "60Gi"

[proving_pod.t2d]
machine_family = "t2d"
image          = "debian-cloud/debian-12"

[proving_pod.t2d.leaf_worker]
machine_type    = "t2d-standard-60"
disk_type       = "pd-balanced"
disk_size_gb    = 100
chunk_size      = 2
cpu_requests    = "30"
memory_requests = "120Gi"

[proving_pod.t2d.aggregator]
machine_type    = "t2d-standard-16"
disk_type       = "pd-balanced"
disk_size_gb    = 50
cpu_requests    = "16"
memory_requests = "32Gi"
