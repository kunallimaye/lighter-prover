# Project Configuration & Infrastructure Toolkit
#
# Copy this file to config.toml and customize your settings.
# config.toml is gitignored — never commit it.
#
# This file defines the Google Cloud infrastructure and target Service Accounts
# (including required IAM role allocations) for the Lighter prover platform.

[project]
name = "lighter-prover"

[gcp.defaults]
project = "kunal-scratch"
region  = "us-central1"

[gcp.state]
# Google Cloud Storage bucket used as remote backend for Terraform state files.
# Automatically verified and created by `make cloud-admin-init`.
bucket = "kunal-scratch-tfstate"
prefix = "lighter-prover-iac"

# ─── Target Service Accounts & Role Allocations ────────────────────────
# Identities and IAM permissions required by Cloud Build and runtime workloads.
# Note: You may add ANY arbitrary Service Account entries below (e.g. [gcp.target.monitor_sa]).
# Run `make cloud-admin-init` to automatically create all defined Service Accounts
# and bind the enumerated IAM roles on your Google Cloud project.
# Run `make cloud-admin-undo` to symmetrically revoke these roles and delete the SAs.

[gcp.target]
# Cloud Build execution machine type (e.g. UNSPECIFIED, E2_HIGHCPU_8, E2_HIGHCPU_32)
build_machine_type = "UNSPECIFIED"

[gcp.target.build_sa]
email = "lighter-builder@kunal-scratch.iam.gserviceaccount.com"
# Roles expected by Cloud Build to execute Terraform pipelines and push images.
roles = [
  "roles/cloudbuild.builds.builder",
  "roles/storage.objectAdmin",
  "roles/artifactregistry.admin"
]

[gcp.target.runtime_sa]
email = "lighter-runtime@kunal-scratch.iam.gserviceaccount.com"
# Least-privilege roles expected by GCE instances / Cloud Run workloads at runtime.
roles = [
  "roles/artifactregistry.reader",
  "roles/logging.logWriter",
  "roles/monitoring.metricWriter"
]

# ─── Virtual Machines List & Default Inheritance ───────────────────────
# Define GCE instances provisioned when running `make cloud-deploy`.
# All individual VMs inherit properties from `[vms.default]` unless explicitly overridden.

[vms.default]
machine_type    = "c4-standard-8"
zone            = "us-central1-a"
disk_size_gb    = 100
disk_type       = "pd-ssd"
# Default OS boot image (e.g. debian-cloud/debian-12, ubuntu-os-cloud/ubuntu-2204-lts)
image           = "debian-cloud/debian-12"
service_account = "lighter-runtime@kunal-scratch.iam.gserviceaccount.com"

[vms.prover-vm-1]
# Inherits machine_type, zone, disk_size_gb, disk_type, and service_account exactly from [vms.default]

[vms.prover-vm-2]
machine_type = "c4-standard-16"
zone         = "us-central1-b"
disk_size_gb = 200
# Inherits disk_type and service_account from [vms.default]
