# ─── Stage 1: Build Plonky2 STARK Proving Engine & Bench Harness ────
FROM rust:latest AS builder

WORKDIR /app

# Install required upstream nightly toolchain
COPY rust-toolchain ./
RUN rustup install $(cat rust-toolchain) && rustup default $(cat rust-toolchain)

# Copy manifests for dependency resolution
COPY Cargo.toml Cargo.lock ./
COPY circuit/Cargo.toml circuit/Cargo.toml
COPY bench/Cargo.toml bench/Cargo.toml

# Copy circuit and bench crates
COPY circuit/ circuit/
COPY bench/ bench/

ARG RUSTFLAGS
ARG CARGO_FEATURES=""
RUN if [ -n "${CARGO_FEATURES}" ]; then \
      RUSTFLAGS=${RUSTFLAGS} cargo build --release --target x86_64-unknown-linux-gnu --bin bench --bin prover-node --bin lighter-coordinator --features "${CARGO_FEATURES}"; \
    else \
      RUSTFLAGS=${RUSTFLAGS} cargo build --release --target x86_64-unknown-linux-gnu --bin bench --bin prover-node; \
      touch /app/target/x86_64-unknown-linux-gnu/release/lighter-coordinator; \
    fi

# Bake circuit artifacts into the image (issue #322 Phase B + node follow-up).
# Runs the just-built prover-node `bake` subcommand to serialise:
#   * the app circuits (pre-exec + BlockTx@S=1) — the #322 Phase B set, and
#   * the reduction-tree NODE circuits (Hex chain) for levels 1..=BAKE_NODE_LEVELS
#     plus the BatchTarget leaf they pin (the #322 node-baking follow-up).
# All artifacts land in /artifacts, VK-identity-verified per artifact. The
# runtime pod then LOADS these from /data/circuits instead of rebuilding: app
# circuits ~6.8x faster cold start, and node circuits skip the ~400 core-sec/
# block cold build (a node's expensive build::<C>() is replaced by a deserialise
# + a CHEAP define() target reconstruction; see prover_node.rs
# `build_or_load_node_circuit_for_level`).
#
# IMAGE-SIZE NOTE: node artifacts are LARGE — ~0.5 GiB (L1) + ~1.1 GiB (L2) =
# ~1.6 GiB for BAKE_NODE_LEVELS=2 (the default; radix-16 depth for 125-500
# leaves is 2-3). This materially grows the runtime image. To trade image size
# for cold-start cost, set --build-arg BAKE_NODE_LEVELS=0 (bakes only the app
# circuits; nodes build on demand, exactly the #322 Phase B behaviour).
#
# FAIL LOUD: bake must succeed or the build fails (issue #342). The old
# `|| echo WARNING` swallowed a bake crash and shipped an EMPTY /data/circuits,
# so every pod silently cold-BUILT every circuit (~80s hex folds instead of
# ~10s loads) on EVERY image since #322/#338. Bump CIRCUIT_ARTIFACT_VERSION on a
# plonky2/param change to invalidate stale art.
#
# PORTABLE BAKE BINARY (issue #342): the runtime binary above is compiled with
# RUSTFLAGS=-C target-cpu=znver4 / x86-64-v4 (AVX-512). The Cloud Build worker
# does NOT support AVX-512, so RUNNING that binary here crashes with SIGILL
# ("Illegal instruction"). Cross-COMPILING AVX-512 is fine (the compiler emits
# instructions it never runs); baking is the only step that EXECUTES the binary
# on the worker. So we build a SEPARATE bake-only prover-node at x86-64-v3 (AVX2,
# supported by every Cloud Build worker) into a distinct CARGO_TARGET_DIR and
# bake with THAT. Baked artifacts are serialised CircuitData (plain data, no
# machine code) stamped with the plonky2 rev (CIRCUIT_ARTIFACT_VERSION), NOT the
# CPU — so a v3-baked artifact loads and VK-verifies identically under the v4
# runtime. The runtime binaries above stay at the fast znver4/v4 target.
RUN if [ -n "${CARGO_FEATURES}" ]; then \
      CARGO_TARGET_DIR=/app/bake-target RUSTFLAGS="-C target-cpu=x86-64-v3" cargo build --release --target x86_64-unknown-linux-gnu --bin prover-node --features "${CARGO_FEATURES}"; \
    else \
      CARGO_TARGET_DIR=/app/bake-target RUSTFLAGS="-C target-cpu=x86-64-v3" cargo build --release --target x86_64-unknown-linux-gnu --bin prover-node; \
    fi

# Comma-separated chunk sizes to bake the BlockTx circuit for, so the image
# is warm for whatever C a run selects (bake vs run must not drift — attempt-49
# baked s1 but ran C=4). Default "1,4" covers the C=1 smoke + C=4 GKE default.
ARG BAKE_TX_PER_PROOF=1,4
ARG BAKE_NODE_LEVELS=2
RUN mkdir -p /artifacts && RUST_MIN_STACK=4294967296 \
      /app/bake-target/x86_64-unknown-linux-gnu/release/prover-node bake \
      --tx-per-proof "${BAKE_TX_PER_PROOF}" \
      --bake-node-levels "${BAKE_NODE_LEVELS}" \
      --artifact-dir /artifacts

# ─── Stage 2: Minimal High-Throughput Compute Runtime ────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /data

# Copy compiled bench harness, distributed prover daemon and default test fixture
COPY --from=builder /app/target/x86_64-unknown-linux-gnu/release/bench /usr/local/bin/bench
COPY --from=builder /app/target/x86_64-unknown-linux-gnu/release/prover-node /usr/local/bin/prover-node
COPY --from=builder /app/target/x86_64-unknown-linux-gnu/release/lighter-coordinator /usr/local/bin/lighter-coordinator
COPY bench/bench_test.json /data/bench_test.json
# Bake the per-tx pre-state corpus into the image so distributed leaf workers
# read it instead of silently falling back to the O(N²) prefix replay (issue
# #318). Shipped RAW (uncompressed) — NOT the .gz — so the in-pod load pays NO
# gunzip cost; latency measurement is critical to this project and a per-startup
# decompress would pollute it. The binary probes /data/captured_corpus.json
# first (see prover_node.rs `prestate_corpus_path`).
COPY bench/corpus/cap-block/captured_corpus.json /data/captured_corpus.json
# Baked circuit artifacts (issue #322 Phase B). The prover-node probes
# /data/circuits first (see prover_node.rs `circuit_artifact_dir`) and loads
# a version-matching artifact instead of rebuilding; on any miss it builds.
COPY --from=builder /artifacts /data/circuits

ENV RUST_LOG=info

ENTRYPOINT ["bench"]
