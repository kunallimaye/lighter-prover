logs/
# bench-fleet parser test fixtures are intentionally committed .log files
!scripts/bench-fleet/tests/fixtures/*.log
# Coordinator-telemetry parser test fixtures (#321 Phase 7 / #328) are
# intentionally committed synthetic .log files (labeled SYNTHETIC, never
# measured, never under reports/). Needed by test_extract_gke_telemetry.py.
!infra-as-code/scripts/tests/fixtures/*.log
# Detached orchestration state (heartbeat/checkpoint/recovery files, #140)
.orchestration/
# Go
/bin/
/vendor/

# Python bytecode (bench/feeder tooling)
__pycache__/
*.pyc

# Downloaded/recorded streaming-bench traces (#54) — banked canonical
# trace lives in GCS, too big to commit (anchored: repo-root only, cf. #27)
/traces/

# Local bench binary (#56) — `make -C bench build` MOVES
# ../target/release/bench here; it is a per-machine build artifact,
# never tracked (anchored, cf. #27/#28). The upstream-committed copy
# was a foreign-arch Mach-O arm64 binary that broke stream-bench on
# Linux x86_64 with Exec format error.
/bench/bench

# Rendered K8s deployment artifacts (#295) — generated at deploy time by
# infra-as-code/scripts/render_pod_spec.py from config.toml. Per-level tree
# Jobs, leaf/root manifests, and the tree.plan.env (cross-level gating geometry)
# are build outputs, never committed.
infra-as-code/kubernetes/*-leaf.rendered.yaml
infra-as-code/kubernetes/*-tree.rendered.yaml
infra-as-code/kubernetes/*-tree-l*.rendered.yaml
infra-as-code/kubernetes/*-tree-root.rendered.yaml
infra-as-code/kubernetes/*-tree.plan.env

# Local benchmark harness outputs (#321 Phase 7 / #328): `make bench-reduction-local`
# writes the captured coordinator.log + derived bench_summary.json here. These
# are per-run measured/UNMEASURED artifacts, never committed (and never under
# reports/, so the anti-fabrication guard is unaffected).
/out/
# Filesystem-transport proofs produced by the local leaf->tree->root pipeline
# (test-distributed-fast / bench-reduction-local). Per-run build artifacts.
reports/stark_proofs/
